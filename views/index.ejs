<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="title">
        <h1>EJEMPLO DE UN CHAT</h1>
    </div>
    <div id="chat">
        <input type="text" id="username" placeholder="Ingrese su nombre de Usuario">
        
        <div id="messages">
        </div>
        
        <div id="writing">
        </div>
        
        <textarea id="writeMessage" placeholder="Ingrese su Mensaje"></textarea>
    </div>

    <script src="socket.io/socket.io.js"></script>
    <script>
        const socket = io()
        const username = document.getElementById('username')
        const writeMessage = document.getElementById('writeMessage')
        const writing = document.getElementById('writing')
        const messages = document.getElementById('messages')

        socket.on('all-messages', (m) => {
            messages.innerHTML = ''
            for (const message of m) {
                const item = document.createElement('div')
                item.className = message.username === 'IA' ? 'message ia' : 'message'
                item.textContent = `${message.username || 'Anónimo'}: ${message.message}`
                messages.appendChild(item)
            }
            messages.scrollTop = messages.scrollHeight
            writing.textContent = ''
        })

        writeMessage.addEventListener('keydown', (event) => {
            socket.emit('writing', username.value)
        })

        let writingTimeout
        socket.on('writing', (user) => {
            writing.textContent = user + " esta escribiendo"
            clearTimeout(writingTimeout)
            writingTimeout = setTimeout(() => {
                writing.textContent = ''
            }, 3000)
        })

        writeMessage.addEventListener('keyup', (event) => {
            if (event.key === "Enter") {
                const user = username.value.trim()
                const text = writeMessage.value.trim()
                if (!user || !text) {
                    writeMessage.value = ""
                    return alert("El nombre del usuario y el mensaje son requeridos")
                }
                socket.emit('new-message', {
                    username: user,
                    message: text
                })
                writeMessage.value = ""
            }
        })
    </script>
    
</body>
</html>